# ============================================================
# LJL Mall Server · 环境变量模板
# 复制为 .env 后按实际情况填写
# ============================================================

# — 运行环境 —
NODE_ENV=development
PORT=3001

# — JWT（生产环境**必须**设置强随机值，否则启动报错）—
JWT_SECRET=change-me-to-a-strong-random-secret-in-production

# — MySQL 8.x 连接（留空则使用内存存储 mock 模式）—
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE=ljl_mall

# — SMS 短信网关 —
# 留空或 mock 则使用本地 mock 模式（验证码固定 123456）
# SMS_PROVIDER=aliyun   # aliyun | tencentcloud | mock
# SMS_ACCESS_KEY=LTAI5t...
# SMS_SECRET_KEY=xxxxxxxx
# SMS_SIGN_NAME=零距离广告商城
# SMS_TEMPLATE_CODE=SMS_123456789

# — CORS —
CORS_ORIGIN=*
