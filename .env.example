# ============================================
# 🚀 零距离广告商城 — 后端环境变量模板
# ============================================
# 复制此文件为 .env 并填入实际值
# ⚠️ .env 已在 .gitignore，切勿提交到 Git！

# ---------- 服务 ----------
# 后端监听端口
PORT=3001

# 运行环境 (development | production)
# production 下: TypeORM synchronize=false, Helmet CSP 严格, CORS 白名单强制
NODE_ENV=development

# ---------- 🔐 JWT ----------
# 签名密钥 (最小 32 字符)
# 生产必须换强随机值, 禁止使用默认值！
JWT_SECRET=change-me-to-a-strong-random-secret-in-production-min-32-chars

# ---------- 🌐 CORS ----------
# 跨域白名单: 逗号分隔多域名, 或 '*' 开发模式全开放
# 开发可留空或 '*'; 生产必须显式列出前端域名
# CORS_ORIGIN=https://your-h5-domain.com,https://mp.weixin.qq.com
CORS_ORIGIN=*

# ---------- 🗄️ MySQL ----------
# 数据库连接 (SQLite 无需这些)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=ljl_sc

# ---------- 🧪 测试 ----------
# e2e 测试用 API 基地址 (可选, 默认 http://localhost:3001)
# API_BASE=http://localhost:3001
