    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
